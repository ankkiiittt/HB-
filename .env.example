# ==============================================================================
# HB+ Environment Configuration Template
# All EXPO_PUBLIC_* variables are exposed to the client bundle at build/runtime.
# ==============================================================================

# Allowed domain for OAuth access (strictly enforced on client + Firestore rules)
EXPO_PUBLIC_ALLOWED_DOMAIN=hbplus.fit

# Firebase Web Configuration (from Firebase Console -> Project Settings -> General)
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=hb-plus-demo.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=hb-plus-demo
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=hb-plus-demo.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Google OAuth Client IDs (from Google Cloud Console / Firebase Authentication)
# Web Client ID (Required for web popup/redirect and token exchange on native)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Native OAuth Client IDs (Optional: for standalone iOS / Android builds)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id.apps.googleusercontent.com

# Admin Script (for scripts/set-admin.ts; DO NOT expose to client)
# Path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json
